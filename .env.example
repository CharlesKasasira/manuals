DATABASE_URL="mysql://db-user:db-password@127.0.0.1:3306/db-name"
JWT_SECRET="dev-secret-change-me"
API_PORT="4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
UPLOAD_ROOT="./uploads"

# Optional OIDC SSO. Works with Google Workspace, Microsoft Entra ID, Okta, and Keycloak.
# For multiple providers, set SSO_OIDC_PROVIDERS to a JSON object keyed by provider id.
# Example:
# SSO_OIDC_PROVIDERS='{"okta":{"label":"Okta","issuer":"https://example.okta.com/oauth2/default","clientId":"...","clientSecret":"...","redirectUri":"http://localhost:4000/auth/sso/okta/callback","role":"user"}}'
# Single-provider shortcut:
# SSO_OIDC_ID="keycloak"
# SSO_OIDC_LABEL="Keycloak"
# SSO_OIDC_ISSUER="https://keycloak.example.com/realms/manuals"
# SSO_OIDC_CLIENT_ID="manuals"
# SSO_OIDC_CLIENT_SECRET="change-me"
# SSO_OIDC_REDIRECT_URI="http://localhost:4000/auth/sso/keycloak/callback"
# SSO_OIDC_DEFAULT_ROLE="user"
